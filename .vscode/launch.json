{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Flask Backend",
      "type": "python",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "development",
        "SECRET_KEY": "miniforum-dev-secret-key"
      },
      "args": [
        "run",
        "--port=5000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true
    }
  ],
  "compounds": []
}
